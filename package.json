{
  "name": "chatbot-backend",
  "version": "1.0.0",
  "description": "Facebook & LINE chatbot backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "chatbot",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "eslint": "9.15.0",
    "prettier": "3.4.1",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}