{
  "name": "chatbot-service",
  "version": "1.0.0",
  "description": "Facebook & LINE chatbot service with RAG auto-reply",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -P tsconfig.dev.json src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "chatbot",
    "facebook",
    "line",
    "rag",
    "express"
  ],
  "author": "Dev Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint": "8.57.0",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.3",
    "vitest": "^2.0.4"
  }
}
